cabal-version: 3.8
name: executables
version: 0.1.0.0
synopsis: Open-source geometric modelling framework
description: Please see the README on GitHub at <https://github.com/ianmackenzie/opensolid#readme>
category: Geometry
homepage: https://github.com/ianmackenzie/opensolid#readme
bug-reports: https://github.com/ianmackenzie/opensolid/issues
author: Ian Mackenzie
maintainer: ian.e.mackenzie@gmail.com
copyright: 2023 Ian Mackenzie
license: MPL-2.0
license-file: LICENSE
build-type: Simple

source-repository head
  type: git
  location: https://github.com/ianmackenzie/opensolid

common config
  default-language: GHC2024
  ghc-options:
    -Wall
    -Werror
    -Wcompat
    -Widentities
    -Wmissing-signatures
    -Wmissing-exported-signatures
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wsafe
    -Wno-pattern-namespace-specifier

  default-extensions:
    BlockArguments
    LexicalNegation
    OverloadedLabels
    OverloadedRecordDot
    OverloadedRecordUpdate
    OverloadedStrings
    PatternSynonyms
    RebindableSyntax
    TypeApplications

library
  import: config
  exposed-modules:
    Utils

  hs-source-dirs: utils
  build-depends: opensolid-core

common executable-config
  import: config
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

executable sandbox
  import: executable-config
  main-is: Main.hs
  hs-source-dirs: sandbox
  build-depends:
    array,
    base,
    containers,
    opensolid-core,
    random,
    text,

executable test-server
  import: executable-config
  main-is: Main.hs
  hs-source-dirs: test-server
  build-depends:
    array,
    base,
    containers,
    opensolid-core,
    opensolid-http,
    random,

